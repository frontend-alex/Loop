APP_ENV = development
// The simulator shares the Mac's network, so localhost is the Mac. A physical iPhone needs
// the Mac's Bonjour name instead (System Settings > General > Sharing > Local hostname);
// both must be on the same Wi-Fi. A raw IP like 192.168.x.x breaks whenever the network changes.
API_BASE_URL = http:/$()/localhost:8080/api/v1
API_BASE_URL[sdk=iphoneos*] = http:/$()/Korab-Cic.local:8080/api/v1
